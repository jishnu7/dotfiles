[core]
	editor = vim
	pager = delta
[interactive]
	diffFilter = delta --color-only


[includeIf "gitdir:~/git/"]
	path = ~/.config/git/personal.config

[color]
	ui = auto
	pager = true
[alias]
	tagcommit = !sh -c 'git rev-list $0 | head -n 1'
	ignore = !git update-index --assume-unchanged
	unignore = !git update-index --no-assume-unchanged
	ignored = !git ls-files -v | grep ^[a-z]
	dc = diff --cached
	edit-unmerged = "!f() { git diff --name-only --diff-filter=U -z -- \"$@\" | xargs -r -0 vim; }; f"
	edit-staged = "!f() { git diff --cached --name-only -z -- \"$@\" | xargs -r -0 vim; }; f"
	edit-modified = "!f() { git ls-files --modified -z -- \"$@\" | xargs -r -0 vim; }; f"
	contributors = !git shortlog -s -n
	sl = "!git stash list | awk -F: '{ print $0; system(\"git stash show -p \" $1); }' -"
	sb = status -sb
	gp = "!git grep $1 -- ':!*.test.js' #"
	pushall = "!f() { b=$(git branch --show-current); for r in $(git remote); do echo \"→ $r\"; git push \"$r\" \"$b\" \"$@\"; done; }; f"
	rm-merged = "!git worktree prune && git branch --format='%(if)%(worktreepath)%(then)%(else)%(refname:short)%(end)' --merged HEAD | grep . | xargs -r -n 1 git branch -d"


[push]
	default = simple

